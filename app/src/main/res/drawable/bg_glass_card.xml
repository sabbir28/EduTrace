<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Refined light-catching gradient for high-fidelity glass effect -->
    <gradient
        android:startColor="#2AFFFFFF"
        android:centerColor="#12FFFFFF"
        android:endColor="#1FFFFFFF"
        android:angle="135" />
    <corners android:radius="32dp" />
    <!-- High-contrast border for better edge definition -->
    <stroke
        android:width="1dp"
        android:color="#3DFFFFFF" />
</shape>
