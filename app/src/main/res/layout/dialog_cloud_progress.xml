<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivCloudProgressIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_cloud"
            app:tint="#FACC15"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCloudProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Cloud Database Sync"
                android:textColor="@android:color/white"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvCloudProgressStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connecting to PostgreSQL..."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarCloud"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:indeterminate="true"
        android:progressTint="#FACC15"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvCloudProgressDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Securing SSL connection to Supabase pooler..."
        android:textColor="#CBD5E1"
        android:textSize="13sp" />

</LinearLayout>
