<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:backgroundTint="#0F172A"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_tile_pill"
        android:backgroundTint="#334155" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_message"
            app:tint="#38BDF8" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Quick Message"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnMsgOpenSystem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tile_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="System Messages"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Recipient Field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dock_item_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="To:"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMsgRecipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="Phone number or contact"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#475569"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Message Body Field -->
    <EditText
        android:id="@+id/etMsgBody"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dock_item_box"
        android:gravity="top|start"
        android:hint="Type message..."
        android:inputType="textMultiLine|textCapSentences"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#475569"
        android:textSize="14sp" />

    <!-- Study Quick Response Templates -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.08"
        android:text="QUICK STUDY TEMPLATES"
        android:textColor="#64748B"
        android:textSize="10sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/templateStudyingNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tile_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Studying right now. Will call back soon."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/templateFocusSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tile_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="In focus session with EduTrace."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/templateShareNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tile_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Can you share today's study notes?"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Send SMS Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendSms"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="Send Message"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:backgroundTint="#2563EB"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_message"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF" />

</LinearLayout>

